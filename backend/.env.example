# Copy to backend/.env and adjust for your environment.
FLOW_DATABASE_URL=mysql+pymysql://flow_app:flow_dev_password@localhost:3306/flow_app
FLOW_CURRENT_USER_ID=user_001
FLOW_CORS_ORIGINS=*
FLOW_JWT_SECRET_KEY=change-me-to-a-long-random-string
FLOW_JWT_ALGORITHM=HS256
FLOW_ACCESS_TOKEN_EXPIRE_MINUTES=60
FLOW_REFRESH_TOKEN_EXPIRE_DAYS=30
FLOW_RESET_TOKEN_EXPIRE_MINUTES=60
FLOW_OTP_EXPIRE_MINUTES=10
FLOW_EMAIL_VERIFY_EXPIRE_MINUTES=10

# Google Sign-In. Comma-separated accepted OAuth2 client ids:
#   - Web client id  -> used by the Flutter web app AND as the Android
#                       serverClientId (so Android ID tokens carry this audience)
#   - iOS client id  -> from GoogleService-Info.plist CLIENT_ID
#   - Android client id (only if the app does not set a serverClientId)
# While empty, ID tokens are trusted unverified (dev mode).
FLOW_GOOGLE_CLIENT_ID=
FLOW_GOOGLE_ALLOW_UNVERIFIED=true

# SMTP for outbound email. While SMTP_HOST is empty, emails are logged to
# the console (dev mode).
FLOW_SMTP_HOST=
FLOW_SMTP_PORT=587
FLOW_SMTP_USER=
FLOW_SMTP_PASSWORD=
FLOW_SMTP_FROM=Flow App <no-reply@flow.local>
